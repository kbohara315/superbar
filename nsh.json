{
  "name": "Superbar",
  "id": "com.superbar.app",
  "version": "1.0.0",
  "icon": "assets/superbar-icon.png",
  "build": 1,
  "capabilities": {
    "network": {
      "hosts": [
        "chatgpt.com",
        "api.anthropic.com"
      ]
    },
    "fs": {
      "read": [
        "${homeDir}/.codex",
        "${homeDir}/.claude",
        "/proc",
        "/sys",
        "${dataDir}"
      ],
      "write": [
        "${dataDir}",
        "${homeDir}/.config/autostart"
      ]
    },
    "process": {
      "execute": [
        "chmod",
        "df",
        "top",
        "vm_stat",
        "sysctl",
        "netstat",
        "pmset",
        "ps"
      ],
      "env": [
        "CODEX_HOME"
      ]
    },
    "notifications": true
  },
  "rust": "native"
}
